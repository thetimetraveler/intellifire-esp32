# Copy this file to secrets.yaml and fill in your own values.
#
#   cp firmware/secrets.yaml.example firmware/secrets.yaml
#
# secrets.yaml is gitignored. Never commit it.
#
# There is deliberately no station Wi-Fi SSID or password here. The firmware
# starts in AP mode as "IntelliFire Fallback"; connect to that AP and use the
# captive portal to enter your network credentials. ESPHome persists them to
# flash, so this is a one-time setup.

# Password for the fallback access point. Use a strong, unique value.
ap_password: "CHANGE-ME-ap-password"

# ESPHome native API encryption key. REPLACE THIS PLACEHOLDER. Generate one with:
#   openssl rand -base64 32
# The value below is 32 zero bytes encoded as base64: it is valid for a config
# check but provides no security.
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# OTA password. Use a strong, unique value.
ota_password: "CHANGE-ME-ota-password"

# MQTT broker used for the diagnostic telemetry stream.
# Use a hostname or address reachable from the device.
mqtt_broker: "192.0.2.10"
mqtt_username: "CHANGE-ME-mqtt-username"
mqtt_password: "CHANGE-ME-mqtt-password"

# Optional: only needed if you add a static Wi-Fi block to fireplace-ecm.yaml.
# The default configuration uses AP mode and the captive portal instead.
# wifi_ssid: "your-network"
# wifi_password: "your-password"
